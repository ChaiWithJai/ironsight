node_modules/
dist/
.DS_Store
*.log

# Captured frames from tools/shoot.sh — regenerated on demand, never committed.
tools/shots/

# Blind A/B sheets from tools/compare.sh. These COMPOSITE A REFERENCE FRAME beside
# ours, so every sheet embeds third-party pixels and falls under exactly the same
# rule as reference/ below: local only, never committed, never shipped. They were
# untracked but not ignored, which meant one `git add -A` would have put real
# Battlefield screenshots into the repo.
tools/compare/

# Scratch capture directories used while bisecting a defect (tools/probe*, etc).
tools/probe*/

# ---------------------------------------------------------------------------
# Third-party reference imagery. LOCAL ONLY — NEVER COMMITTED, NEVER SHIPPED.
#
# Publicly-published press/store screenshots from released titles, pulled down
# purely as a calibration target for the visual critic loop. They are consumed
# as a quality yardstick for light transport, material response and atmosphere;
# no pixel, texture, model or level layout from them enters the build. Nothing
# under reference/ is imported by src/, referenced by the bundle, or tracked.
# ---------------------------------------------------------------------------
reference/

# Blind A/B sheets from tools/compare.sh. These COMPOSITE a reference frame
# beside ours, so they carry third-party imagery and fall under exactly the same
# rule as reference/ itself. The .keys/ subdirectory additionally holds the
# answer keys that critics must not read before recording a verdict.
tools/compare/

dist-*/
tmp-*/

# Soak reports — regenerate with ./tools/soak.sh
tools/soak/
tools/shots-post-*/

# Web-performance reports — regenerate with ./tools/perf.sh
tools/perf/

# Full-game teaching smoke evidence — regenerated with npm run teach:smoke.
tools/teaching/

# Local Netlify folder
.netlify
